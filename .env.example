# Database Connection (Default SQLite for local zero-config, or PostgreSQL for Neon/Supabase)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL: postgresql://user:password@ep-cool-fog-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication Secret
NEXTAUTH_SECRET="your-super-secret-random-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Optional: Mapbox GL Access Token for ultra-high-resolution satellite & custom vector tiles
# (If left empty, our custom-crafted dark vector map engine runs automatically!)
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Optional: Cloudinary credentials for cloud-hosted asset management and dynamic transformations
# (If left empty, our built-in local media upload handler manages files smoothly!)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
